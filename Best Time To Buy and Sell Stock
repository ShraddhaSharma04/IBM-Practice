class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int n=prices.size();
        int min_val=INT_MAX;
        int max_profit=0;
        for(int i=0;i<n;i++)
        {
            if(prices[i]<min_val)
            {
                min_val=prices[i];
            }
            else if((prices[i]-min_val)>max_profit)
            {
                max_profit=prices[i]-min_val;
            }
        }
        return max_profit;
    }
};
